{
  "name": "catscandance-platform",
  "private": true,
  "version": "3.0.0",
  "description": "Cats Can Dance: four products, one platform. apps/ccd (nights, crews, Episodes), apps/artists (pages, booking, tour), apps/gate (hosts and the door). School lives in paramminhas5/Ableton-Final-Next.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:ccd": "pnpm --filter cats-can-dance dev",
    "dev:artists": "pnpm --filter @ccd/artists dev",
    "dev:gate": "pnpm --filter @ccd/gate dev",
    "build:ccd": "pnpm --filter cats-can-dance build",
    "build:artists": "pnpm --filter @ccd/artists build",
    "build:gate": "pnpm --filter @ccd/gate build"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
