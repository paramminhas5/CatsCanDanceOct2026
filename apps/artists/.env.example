# Server only. Set in Vercel, never committed.
# OPS_TOKEN=            token for the ops_* RPCs (staff pages at /desk, booking mail, the release cron)
# CRON_SECRET=          Vercel sends it as "Authorization: Bearer ..." to /api/cron/releases
# RESEND_API_KEY=       booking mail goes out through Resend; nothing is sent without it
# RESEND_FROM=          "Cats Can Dance <bookings@catscandance.com>" once the domain is verified
# OPS_NOTIFY_EMAIL=     the team address that hears about new booking requests
# SSO_SHARED_SECRET=    hand-off tokens for School (packages/auth)
